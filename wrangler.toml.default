name = "aosc-anicca-telegram-bot"
main = "src/index.ts"
compatibility_date = "2025-09-14"
account_id = "ACCOUNT_ID"
workers_dev = true
keep_vars = true

[[kv_namespaces]]
binding = "STATE"
id = "KV_NAMESPACE_ID"

# Keep Cron off for the first migration.
[triggers]
crons = []

[observability.logs]
enabled = true
